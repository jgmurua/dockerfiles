# Example environment for opencode-docker.
# Copy to: ~/.config/opencode-docker/env or ~/.config/opencode-docker/env.<profile>
# Protect real files with: chmod 600 ~/.config/opencode-docker/env*
#
# Do NOT commit real API keys. Docker --env-file reads KEY=VALUE lines.

# -----------------------------------------------------------------------------
# Built-in providers: API keys recognized by current OpenCode/provider plugins
# -----------------------------------------------------------------------------
# OpenAI
#OPENAI_API_KEY=sk-...

# OpenRouter
#OPENROUTER_API_KEY=sk-or-...

# NVIDIA API Catalog / NIM and other OpenAI-compatible endpoints are best
# configured as custom providers via OPENCODE_CONFIG_CONTENT below.
# Some endpoints use an OpenAI-compatible bearer key; use a provider-specific
# variable name and reference it from config with {env:NAME}.
#NVIDIA_API_KEY=nvapi-...
#LOCAL_LLM_API_KEY=not-needed-or-anything

# -----------------------------------------------------------------------------
# Default model selection
# -----------------------------------------------------------------------------
# OpenCode's real config key for model selection is "model" in opencode.json,
# using "provider/model". The easiest profile-specific way to set it without
# rebuilding the image is OPENCODE_CONFIG_CONTENT (JSON/JSONC in one line).

# OpenAI example:
#OPENCODE_CONFIG_CONTENT={"model":"openai/gpt-4.1"}

# OpenRouter example:
#OPENCODE_CONFIG_CONTENT={"model":"openrouter/anthropic/claude-3.5-sonnet"}

# -----------------------------------------------------------------------------
# Local llama.cpp llama-server / OpenAI-compatible endpoint on the host
# -----------------------------------------------------------------------------
# Start llama-server on the host with an OpenAI-compatible /v1 API, then use
# host.docker.internal from inside Docker. Native OpenCode custom provider config
# uses the "provider" map and provider options.baseURL for OpenAI-compatible APIs.
# Replace MODEL_ID with the model name returned by /v1/models if applicable.
#
#LOCAL_LLM_API_KEY=unused
#OPENCODE_CONFIG_CONTENT={"model":"local/MODEL_ID","provider":{"local":{"npm":"@ai-sdk/openai-compatible","name":"Local llama.cpp","env":["LOCAL_LLM_API_KEY"],"options":{"baseURL":"http://host.docker.internal:8080/v1","apiKey":"{env:LOCAL_LLM_API_KEY}"},"models":{"MODEL_ID":{"name":"Local model","tool_call":true,"limit":{"context":8192,"output":4096}}}}}}

# NVIDIA NIM/OpenAI-compatible example:
#NVIDIA_API_KEY=nvapi-...
#OPENCODE_CONFIG_CONTENT={"model":"nvidia/meta/llama-3.1-70b-instruct","provider":{"nvidia":{"npm":"@ai-sdk/openai-compatible","name":"NVIDIA NIM","env":["NVIDIA_API_KEY"],"options":{"baseURL":"https://integrate.api.nvidia.com/v1","apiKey":"{env:NVIDIA_API_KEY}"},"models":{"meta/llama-3.1-70b-instruct":{"name":"Llama 3.1 70B Instruct","tool_call":true,"limit":{"context":131072,"output":4096}}}}}}
